          "return true;"
        ],
        "axnScript": [
          "var num = Numbers();",
          "var wps = Agent.actions[\"YubgCsxa\"][\"params\"].get();",
          "for (var i = 0; i < wps.size(); ++i) ",
          "{",
          "    var wp = wps[i];",
          "    num.push_back(wp.lon);",
          "    num.push_back(wp.lat);",
          "    num.push_back(wp.hgt);",
          "}",
          "//print(\"evtol\");",
          "//print(num);",
          "Agent.dyn_set_mode(\"iagnt_dynamics_evtol_simple\", 22, num);"
