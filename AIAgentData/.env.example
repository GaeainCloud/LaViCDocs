# Required for Rodin-related scripts
RODIN_API_KEY=

# Optional: used by blender_mcp_addon free-trial button
RODIN_FREE_TRIAL_KEY=

# Optional runtime paths (defaults are relative to this project)
# AIALAVIC_BASE_DIR=/absolute/path/to/AIAgentData
# AIALAVIC_MODELS_DIR=/absolute/path/to/AIAgentData/models
# AIALAVIC_DOWNLOADS_DIR=/absolute/path/to/AIAgentData/models/downloads

# Optional network proxy
# AIALAVIC_PROXY_URL=http://127.0.0.1:7897

# Optional: allow placeholder assets when real assets are unavailable
# AIALAVIC_ALLOW_PLACEHOLDER=1
